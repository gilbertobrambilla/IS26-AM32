<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefWidth="280.0" minWidth="280.0" maxWidth="280.0" spacing="15.0" styleClass="mesos-panel"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am32.client.view.gui.controllers.OpponentsSidebarViewController">

    <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
    </padding>

    <Label styleClass="text-main" text="OPPONENTS">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="opponentsContainer" alignment="TOP_CENTER" spacing="15.0">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>
</VBox>