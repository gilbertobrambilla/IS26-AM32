<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER"
      prefHeight="60.0"
      spacing="50.0"
      styleClass="top-bar"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am32.client.view.gui.controllers.TopBarViewController">

    <HBox alignment="CENTER" spacing="10.0">
        <Label styleClass="subtitle-text" text="ERA:" />
        <Label fx:id="eraLabel" styleClass="top-bar-era-value" text="I" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Label styleClass="subtitle-text" text="ROUND:" />
        <Label fx:id="roundLabel" styleClass="top-bar-round-value" text="1" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Label styleClass="subtitle-text" text="PHASE:" />
        <Label fx:id="phaseLabel" styleClass="top-bar-phase-value" text="PLACE TOTEMS" />
    </HBox>

</HBox>
