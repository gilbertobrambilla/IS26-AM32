<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am32.client.view.gui.controllers.BoardViewController">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>

    <VBox alignment="CENTER" spacing="5.0">
        <Label text="UPPER DECK">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <HBox fx:id="upperRowCardsContainer"
              alignment="CENTER"
              spacing="10.0"
              prefHeight="124.0"
              minHeight="124.0"
              maxHeight="124.0"
              style="-fx-background-color: #ef4a23; -fx-background-radius: 10;">
            <padding>
                <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
            </padding>
        </HBox>
    </VBox>

    <HBox alignment="CENTER" spacing="18.0">
        <VBox fx:id="turnOrderContainer"
              alignment="TOP_CENTER"
              prefWidth="138.0"
              minWidth="138.0"
              maxWidth="138.0"
              spacing="5.0"
              style="-fx-background-color: #714b4d; -fx-background-radius: 6; -fx-border-color: #666; -fx-border-radius: 6;">
            <padding>
                <Insets top="6.0" right="6.0" bottom="6.0" left="6.0" />
            </padding>
        </VBox>

        <VBox alignment="TOP_CENTER" spacing="5.0">
            <Label text="OFFER TRACK">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>

            <HBox fx:id="offersContainer"
                  alignment="CENTER"
                  spacing="14.0"
                  prefWidth="620.0"
                  minWidth="620.0"
                  maxWidth="620.0"
                  prefHeight="88.0"
                  minHeight="88.0"
                  maxHeight="88.0"
                  style="-fx-background-color: #714b4d; -fx-background-radius: 6;">
                <padding>
                    <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
                </padding>
            </HBox>
        </VBox>
    </HBox>

    <VBox alignment="CENTER" spacing="5.0">
        <Label text="LOWER DECK">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <HBox fx:id="lowerRowCardsContainer"
              alignment="CENTER"
              spacing="10.0"
              prefHeight="124.0"
              minHeight="124.0"
              maxHeight="124.0"
              style="-fx-background-color: #ef4a23; -fx-background-radius: 10;">
            <padding>
                <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
            </padding>
        </HBox>
    </VBox>

    <Button fx:id="confirmActionButton"
            mnemonicParsing="false"
            onAction="#handleConfirmAction"
            text="Conferma Selezione"
            visible="false"
            style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
        <font>
            <Font size="14.0" />
        </font>
        <padding>
            <Insets top="5.0" right="20.0" bottom="5.0" left="20.0" />
        </padding>
    </Button>

</VBox>
