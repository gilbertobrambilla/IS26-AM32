<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am32.client.view.gui.controllers.BoardViewController">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>

    <!-- ── Upper card row ─────────────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="5.0">
        <Label styleClass="board-section-label" text="UPPER DECK" />

        <HBox fx:id="upperRowCardsContainer"
              alignment="CENTER"
              spacing="10.0"
              prefHeight="124.0" minHeight="124.0" maxHeight="124.0"
              styleClass="board-card-row">
            <padding>
                <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
            </padding>
        </HBox>
    </VBox>

    <!-- ── Middle row: turn order + offer track ───────────────────────────── -->
    <HBox alignment="CENTER" spacing="18.0">

        <VBox fx:id="turnOrderContainer"
              alignment="TOP_CENTER"
              prefWidth="138.0" minWidth="138.0" maxWidth="138.0"
              spacing="5.0"
              styleClass="board-track-panel">
            <padding>
                <Insets top="6.0" right="6.0" bottom="6.0" left="6.0" />
            </padding>
        </VBox>

        <VBox alignment="TOP_CENTER" spacing="5.0">
            <Label styleClass="board-section-label" text="OFFER TRACK" />

            <HBox fx:id="offersContainer"
                  alignment="CENTER"
                  spacing="14.0"
                  prefWidth="730.0" minWidth="730.0" maxWidth="730.0"
                  prefHeight="88.0" minHeight="88.0" maxHeight="88.0"
                  styleClass="board-track-panel">
                <padding>
                    <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
                </padding>
            </HBox>
        </VBox>
    </HBox>

    <!-- ── Lower card row ─────────────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="5.0">
        <Label styleClass="board-section-label" text="LOWER DECK" />

        <HBox fx:id="lowerRowCardsContainer"
              alignment="CENTER"
              spacing="10.0"
              prefHeight="124.0" minHeight="124.0" maxHeight="124.0"
              styleClass="board-card-row">
            <padding>
                <Insets top="6.0" right="10.0" bottom="6.0" left="10.0" />
            </padding>
        </HBox>
    </VBox>

    <!-- ── Confirm selection button ───────────────────────────────────────── -->
    <!-- Hidden by default; shown by BoardViewController when cards are selected. -->
    <Button fx:id="confirmActionButton"
            mnemonicParsing="false"
            onAction="#handleConfirmAction"
            text="Confirm Selection"
            visible="false"
            managed="false"
            disable="true"
            styleClass="confirm-action-button">
        <padding>
            <Insets top="5.0" right="20.0" bottom="5.0" left="20.0" />
        </padding>
    </Button>

</VBox>
