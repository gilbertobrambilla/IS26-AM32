<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #fbb85c;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am32.client.view.gui.controllers.InGameViewController">

    <BorderPane prefHeight="800.0" prefWidth="1280.0">
        <top>
            <fx:include fx:id="topBar" source="top-bar-view.fxml" />
        </top>

        <right>
            <fx:include fx:id="opponentsSidebar" source="opponents-sidebar-view.fxml" BorderPane.alignment="CENTER" />
        </right>

        <center>
            <fx:include fx:id="board" source="board-view.fxml" />
        </center>

        <bottom>
            <fx:include fx:id="playerDashboard" source="player-dashboard-view.fxml" BorderPane.alignment="CENTER" />
        </bottom>
    </BorderPane>

    <VBox fx:id="suspensionOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(0, 0, 0, 0.75);" visible="false">
        <Label fx:id="suspensionMessageLabel" text="Game Suspended. Waiting for players to reconnect..." textFill="WHITE">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
    </VBox>

    <VBox alignment="TOP_CENTER" mouseTransparent="true" pickOnBounds="false">
        <padding>
            <Insets top="20.0" />
        </padding>
        <HBox fx:id="toastContainer" alignment="CENTER" maxWidth="450.0" spacing="15.0" style="-fx-background-color: #ff4444; -fx-background-radius: 25px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 4);" visible="false">
            <padding>
                <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
            </padding>
            <Label fx:id="toastLabel" text="Error message holder" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
        </HBox>
    </VBox>

</StackPane>
